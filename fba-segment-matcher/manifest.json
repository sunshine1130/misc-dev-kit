{
  "manifest_version": 3,
  "name": "FBA分段匹配工具",
  "version": "1.0.0",
  "description": "读取FBA配置参数，根据输入的长宽高和毛重自动匹配实际发货重量分段区间",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FBA分段匹配工具"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}