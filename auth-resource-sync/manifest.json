{
  "manifest_version": 3,
  "name": "Auth Resource Sync - 权限资源同步工具",
  "version": "1.5.5",
  "description": "权限资源与用户权限（应用/角色）的跨环境同步工具",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.joyintoy.cn/*",
    "http://*.joyintoy.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.joyintoy.cn/*",
        "http://*.joyintoy.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["perm-map.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "help.html"],
      "matches": [
        "https://*.joyintoy.cn/*",
        "http://*.joyintoy.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auth Resource Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}