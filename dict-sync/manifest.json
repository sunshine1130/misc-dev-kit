{
  "manifest_version": 3,
  "name": "Dict Sync - 字典同步工具",
  "version": "1.2.1",
  "description": "将测试环境的字典配置同步到目标环境（生产环境只读）",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.joyintoy.cn/*",
    "http://*.joyintoy.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.joyintoy.cn/*",
        "http://*.joyintoy.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["env-guard.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "help.html"],
      "matches": [
        "https://*.joyintoy.cn/*",
        "http://*.joyintoy.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dict Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}